# Environment Configuration Example
# Copy this file to .env and .env.production and fill in the actual values
VITE_API_URL=http://localhost:3001
VITE_DEBUG_STATE=false

# fal.ai API key (used by scripts/generate-images.js)
FAL_KEY=

# Demo release (scripts/release-demos.js): where exported demo sites and project backups go
DEMOS_DIR=
DEMO_BACKUPS_DIR=

# Export viewer (View on the Export page shows exports on their own port).
# EXPORT_VIEWER_PORT: a fixed port, or "off" for no viewer (last resort: root-relative links and 404 pages break in View). Default: the app's port + 1, else a free one.
# EXPORT_VIEWER_PORT=3002
# EXPORT_VIEWER_URL: the viewer's public address when the browser reaches it some other way (e.g. a proxy host). An absolute http(s) URL; only its origin is used.
# EXPORT_VIEWER_URL=https://view.example.com
