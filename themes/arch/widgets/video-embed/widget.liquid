{%- assign video_src = '' -%}
{%- if widget.settings.video_file != blank -%}
  {%- assign video_name = widget.settings.video_file | split: '/' | last -%}
  {%- assign video_src = filePath | append: '/' | append: video_name -%}
  {% enqueue_script src: "video-embed.js", priority: 30, defer: true %}
{%- endif -%}
{%- assign video_label = widget.settings.video_title -%}
{%- if video_label == blank -%}
  {%- assign video_label = 'site.video_embed.default_title' | t -%}
{%- endif -%}

<section
  id="{{ widget.id }}"
  class="widget widget-type-video-embed widget-{{ widget.id }} color-scheme-{{ widget.settings.color_scheme }}{% if widget.settings.top_spacing != 'auto' %} spacing-top-{{ widget.settings.top_spacing }}{% endif %}{% if widget.settings.bottom_spacing != 'auto' %} spacing-bottom-{{ widget.settings.bottom_spacing }}{% endif %}"
  {% unless widget.settings.color_scheme == 'standard-primary' %}
    style="--widget-bg-color: var(--bg-primary);"
  {% endunless %}
  data-widget-id="{{ widget.id }}"
  data-widget-type="video-embed"
  {% if widget.index != null %}data-widget-index="{{ widget.index }}"{% endif %}
>
  {%- comment -%} Convert YouTube/Vimeo URL to embed URL {%- endcomment -%}
  {%- assign video_url = widget.settings.video_url -%}
  {%- assign embed_url = '' -%}

  {%- if video_url contains 'youtube.com/watch' -%}
    {%- assign video_id = video_url | split: 'v=' | last | split: '&' | first -%}
    {%- assign embed_url = 'https://www.youtube.com/embed/' | append: video_id -%}
  {%- elsif video_url contains 'youtu.be/' -%}
    {%- assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
    {%- assign embed_url = 'https://www.youtube.com/embed/' | append: video_id -%}
  {%- elsif video_url contains 'youtube.com/embed/' -%}
    {%- assign embed_url = video_url -%}
  {%- elsif video_url contains 'vimeo.com/' -%}
    {%- assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first -%}
    {%- assign embed_url = 'https://player.vimeo.com/video/' | append: video_id -%}
  {%- elsif video_url contains 'player.vimeo.com' -%}
    {%- assign embed_url = video_url -%}
  {%- else -%}
    {%- assign embed_url = '' -%}
  {%- endif -%}

  {%- comment -%} Calculate aspect ratio padding {%- endcomment -%}
  {%- assign aspect_padding = '56.25%' -%}
  {%- case widget.settings.aspect_ratio -%}
    {%- when '4:3', '4 / 3' -%}
      {%- assign aspect_padding = '75%' -%}
    {%- when '21:9' -%}
      {%- assign aspect_padding = '42.86%' -%}
    {%- when '1:1', '1 / 1' -%}
      {%- assign aspect_padding = '100%' -%}
  {%- endcase -%}

  <style>
    .widget-{{ widget.id }} {
      & .video-embed-container {
        position: relative;
        padding-block-end: {{ aspect_padding }};
        height: 0;
        overflow: hidden;

        & iframe,
        & video {
          position: absolute;
          inset-block-start: 0;
          inset-inline-start: 0;
          width: 100%;
          height: 100%;
          border: var(--border-width-thin) solid var(--border-color);
          border-radius: var(--radius-md);
        }

        & video {
          background-color: #000;
          object-fit: contain;
        }
      }

      & .video-embed-error {
        margin-block-start: var(--space-sm);
        text-align: center;
      }

      & .video-embed-placeholder {
        text-align: center;
        padding: var(--space-2xl);
      }
    }
  </style>

  <div class="widget-container {% unless widget.settings.color_scheme == 'standard-primary' %}widget-container-padded{% endunless %}">
    {% if widget.settings.title != blank or widget.settings.description != blank or widget.settings.eyebrow != blank %}
      <div class="widget-header{% if widget.settings.heading_alignment == 'start' %} widget-header--align-start{% endif %}">
        {% assign header_delay = 0 %}
        {% if widget.settings.eyebrow != blank %}
          <span class="w-eyebrow{% if widget.settings.eyebrow_uppercase %} t-uppercase{% endif %} reveal reveal-up" style="--reveal-delay: {{ header_delay }}" data-setting="eyebrow">{{ widget.settings.eyebrow }}</span>
          {% assign header_delay = header_delay | plus: 1 %}
        {% endif %}
        {% if widget.settings.title != blank %}
          {% if widget.index == 1 %}
            <h1 class="w-headline reveal reveal-up" style="--reveal-delay: {{ header_delay }}" data-setting="title">{{ widget.settings.title }}</h1>
          {% else %}
            <h2 class="w-headline reveal reveal-up" style="--reveal-delay: {{ header_delay }}" data-setting="title">{{ widget.settings.title }}</h2>
          {% endif %}
          {% assign header_delay = header_delay | plus: 1 %}
        {% endif %}
        {% if widget.settings.description != blank %}
          <p class="w-description reveal reveal-up" style="--reveal-delay: {{ header_delay }}" data-setting="description">{{ widget.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="widget-content">
      <div class="video-embed-container reveal reveal-fade">
        {% if video_src != blank %}
          {%- assign poster_url = '' -%}
          {%- if widget.settings.poster != blank -%}
            {%- capture poster_url -%}{% image src: widget.settings.poster, size: 'large', output: 'url' %}{%- endcapture -%}
            {%- assign poster_url = poster_url | strip -%}
          {%- endif -%}
          <video
            class="video-embed-player"
            src="{{ video_src }}"
            {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
            aria-label="{{ video_label }}"
            controls
            playsinline
            preload="metadata"
          ></video>
        {% elsif embed_url != blank %}
          <iframe
            src="{{ embed_url }}"
            title="{{ video_label }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        {%- elsif renderMode == 'preview' -%}
          <p class="video-embed-placeholder w-body t-muted">
            Choose an uploaded video or enter a YouTube or Vimeo URL
          </p>
        {% endif %}
      </div>
      {% if video_src != blank %}
        <p class="video-embed-error w-body t-muted" role="alert" hidden>{{ 'site.video_embed.playback_error' | t }}</p>
      {% endif %}
    </div>
  </div>
</section>
