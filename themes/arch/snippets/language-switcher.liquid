{%- comment -%}
  `render` gets no parent scope, so the caller passes `translations` in.
  `landmark: false` drops the <nav> wrapper, for the copy that sits inside the
  header's own navigation — one landmark per switcher.
{%- endcomment -%}
{%- if translations and translations.size > 1 -%}
  {%- if landmark == false -%}
    <ul class="header-languages-list">
      {%- for entry in translations -%}
        <li class="header-languages-item">
          <a
            href="{{ entry.href }}"
            class="header-languages-link{% if entry.active %} is-active{% endif %}"
            lang="{{ entry.hreflang }}"
            {%- if entry.active %} aria-current="true"{% endif -%}
          >{{ entry.label }}</a>
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <nav class="header-languages" aria-label="{{ label }}">
      <details class="header-language-dropdown">
        <summary class="header-language-trigger">
          {%- for entry in translations -%}
            {%- if entry.active -%}{{ entry.label }}{%- endif -%}
          {%- endfor -%}
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
      <ul class="header-languages-list">
        {%- for entry in translations -%}
          <li class="header-languages-item">
            <a
              href="{{ entry.href }}"
              class="header-languages-link{% if entry.active %} is-active{% endif %}"
              lang="{{ entry.hreflang }}"
              {%- if entry.active %} aria-current="true"{% endif -%}
            >{{ entry.label }}</a>
          </li>
        {%- endfor -%}
      </ul>
      </details>
    </nav>
  {%- endif -%}
{%- endif -%}
