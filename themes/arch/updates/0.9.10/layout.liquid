<!doctype html>
<html lang="{{ page.language | default: project.defaultLanguage | default: 'en' }}" dir="{{ page.dir | default: 'ltr' }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="format-detection" content="telephone=no">

    {% seo %}
    {% fonts %}
    
    {% render 'site-icons', site_icons: site_icons %}

    {% theme_settings %}

    {% asset src: "base.css" %}
    {% unless theme.general.enable_reveal_animations %}
      <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
    {% endunless %}
    {% custom_css %}
    {% custom_head_scripts %}
    {% header_assets %}
  </head>
  <body
    class="{{ body_class }} corner-{{ theme.style.corner_style | default: 'sharp' }} spacing-{{ theme.style.spacing_density | default: 'default' }} buttons-{{ theme.style.button_shape | default: 'auto' }}"
    {%- comment -%}
      The scripts build controls in the visitor's browser, after the language is
      long gone, so the words reach them from here.
    {%- endcomment -%}
    data-t-lightbox-preview="{{ 'site.lightbox.preview' | t }}"
    data-t-lightbox-previous="{{ 'site.lightbox.previous' | t }}"
    data-t-lightbox-next="{{ 'site.lightbox.next' | t }}"
    data-t-lightbox-close="{{ 'site.lightbox.close' | t }}"
    data-t-menu-toggle-submenu="{{ 'site.menu.toggle_submenu' | t }}"
  >
    {{ header | raw }}
    {% if theme.general.show_breadcrumbs %}
      {% render 'breadcrumbs', class_nav: 'site-breadcrumbs', class_list: 'breadcrumbs-list', class_item: 'breadcrumbs-item', class_link: 'breadcrumbs-link', class_current: 'is-current' %}
    {% endif %}
    <main id="main-content" class="main-content">
      {{ main_content | raw }}
    </main>
    {{ footer | raw }}
    
    {% asset src: "scripts.js", defer: true %}
    {% if theme.general.enable_reveal_animations %}
      {% asset src: "reveal.js", defer: true %}
    {% endif %}
    {% footer_assets %}
    {% custom_footer_scripts %}
  </body>
</html>

