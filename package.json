{
  "name": "widgetizer",
  "version": "0.9.10",
  "description": "A visual website builder with theme support",
  "homepage": "https://widgetizer.org",
  "author": "Widgetizer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "electron/main.js",
  "exports": {
    "./server": "./packages/builder-server/src/createApp.js"
  },
  "engines": {
    "node": ">=20.19.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint packages app server.js",
    "lint:electron": "eslint electron",
    "lint:all": "eslint .",
    "preview": "vite preview",
    "predev:all": "npm rebuild better-sqlite3 && npm run validate:all-locales",
    "server": "nodemon server.js",
    "start": "node server.js",
    "dev:frontend": "wait-on http://localhost:3001/health && npm run dev",
    "dev:all": "concurrently \"npm run server\" \"npm run dev:frontend\"",
    "start:prod": "cross-env NODE_ENV=production npm start",
    "preelectron:dev": "npm rebuild better-sqlite3 && npm run validate:all-locales",
    "electron:dev": "concurrently -k \"cross-env NODE_ENV=development npm run server\" \"cross-env NODE_ENV=development npm run dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_DEV=1 ELECTRON_DISABLE_INTERNAL_SERVER=1 VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "test": "node --test --test-reporter ./packages/builder-server/src/tests/reporter.js packages/builder-server/src/tests/*.test.js",
    "test:verbose": "VERBOSE=1 node --test --test-reporter ./packages/builder-server/src/tests/reporter.js packages/builder-server/src/tests/*.test.js",
    "test:frontend": "vitest run",
    "theme:sync": "node scripts/theme-sync.js",
    "theme:update-delta": "node scripts/theme-update-delta.js",
    "preset:sync": "node scripts/preset-sync.js",
    "preset:media": "node scripts/pack-preset-media.js",
    "preset:templates": "node scripts/sync-preset-templates.js",
    "demos:release": "node scripts/release-demos.js",
    "validate:theme": "node scripts/validate-theme.js",
    "validate:locales": "node scripts/validate-locales.js",
    "validate:theme-locales": "node scripts/validate-theme-locales.js",
    "validate:all-locales": "node scripts/validate-locales.js && node scripts/validate-theme-locales.js",
    "electron:build:mac": "node scripts/build-electron.mjs --platform mac",
    "electron:build:mac:unsigned": "node scripts/build-electron.mjs --platform mac --unsigned",
    "electron:build:win": "node scripts/build-electron.mjs --platform win",
    "electron:build:win:unsigned": "node scripts/build-electron.mjs --platform win --unsigned",
    "electron:build:linux": "node scripts/build-electron.mjs --platform linux",
    "electron:build:linux:arm64": "node scripts/build-electron.mjs --platform linux --arch arm64",
    "electron:preflight": "npm run validate:all-locales && npm run lint:all"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.5",
    "@widgetizer/adapters-local": "*",
    "@widgetizer/builder-server": "*",
    "@widgetizer/core": "*",
    "@widgetizer/render-engine": "*",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.3",
    "fs-extra": "^11.3.0",
    "i18next": "^25.6.3",
    "liquidjs": "^10.26.0",
    "lucide-react": "^0.563.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.66.1",
    "react-i18next": "^16.3.5",
    "react-router-dom": "^7.5.0",
    "sharp": "^0.34.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.24.0",
    "@napi-rs/canvas": "^0.1.99",
    "@tailwindcss/postcss": "^4.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.2",
    "chokidar": "^5.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^40.8.5",
    "electron-builder": "^26.4.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.0.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  }
}
